# Copy this file to .env and fill in real values. Never commit .env.

# Session
SESSION_SECRET=replace-with-a-long-random-string

# Admin login — generate with: node scripts/hash-password.js "your-password"
ADMIN_PASSWORD_HASH=

# Outgoing email (SMTP) — used to send candidate applications to your inbox
# Works with Gmail (use an App Password), Office 365, or any SMTP provider
# (SendGrid, Postmark, etc). Leave blank during development — applications
# will just be logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=careers@rv2energy.co.uk
APPLICATIONS_INBOX=careers@rv2energy.co.uk

NODE_ENV=production
PORT=3000
